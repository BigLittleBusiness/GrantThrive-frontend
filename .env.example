# GrantThrive Frontend Environment Variables
# ==========================================
# Copy this file to .env. Values are baked in at build time by Vite;
# per-environment values live in .env.production and .env.uat.

# Backend API base URL, including the /api path. All requests go to
# `${VITE_API_URL}/<endpoint>`.
#   Local backend:                    http://localhost:5000/api
#   Backend on its own domain:        https://api.grantthrive.com/api
#   Backend on the same domain:       /api   (proxy routes /api/* to the backend)
VITE_API_URL="http://localhost:5000/api"

# Public Cloudflare Turnstile site key for the marketing contact and waitlist
# forms. The matching secret is backend-only (TURNSTILE_SECRET_KEY).
VITE_TURNSTILE_SITE_KEY=""

# Optional, local development only: act as this council tenant without
# configuring subdomain DNS (e.g. cityofmelbourne).
# VITE_GT_SUBDOMAIN=""
